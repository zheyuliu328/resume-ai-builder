# ============================================
# Cline 成本优化配置 - Resume AI Builder
# ============================================
# 目标：减少不必要的上下文载入，降低 token 消耗

# ============================================
# Python 运行时和缓存（不需要分析）
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
dist/
build/

# ============================================
# 用户数据和输出文件（敏感+无需分析）
# ============================================
# 简历数据（包含个人信息）
resume_data.json
config.json
.env

# 生成的输出文件
resume.html
resume.pdf
temp_resume.html
*.html.bak
*.pdf.bak

# ============================================
# 日志和临时文件（不需要上下文）
# ============================================
*.log
app.log
*.tmp
*.temp
.coverage
htmlcov/

# ============================================
# IDE 和编辑器配置（无关代码逻辑）
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# 测试和验证脚本（除非明确需要调试）
# ============================================
# 注释：如果需要调试测试，可以临时移除这些
test_*.py
verify_*.py
fix_and_test.py

# ============================================
# 文档文件（减少文档上下文消耗）
# ============================================
# 只在需要了解项目架构时才读取
*_GUIDE.md
*_SUMMARY.md
*_TEMPLATE.md
TROUBLESHOOTING.md
FIX_VERIFICATION_REPORT.md
ELECTRON_README.md
PROJECT_SUMMARY.md

# ============================================
# 示例和配置模板（不是实际运行代码）
# ============================================
*.example.json
*.example
.env.example
resume_data.example.json

# ============================================
# 前端依赖（如果存在 node_modules）
# ============================================
node_modules/
package-lock.json
yarn.lock
.npm/
.yarn/

# ============================================
# 浏览器自动化工具缓存
# ============================================
.playwright/
playwright-report/
test-results/

# ============================================
# Git 和版本控制
# ============================================
.git/
.gitignore
.gitattributes

# ============================================
# 脚本工具（非核心代码）
# ============================================
setup.sh
start_server.sh
*.sh.bak
